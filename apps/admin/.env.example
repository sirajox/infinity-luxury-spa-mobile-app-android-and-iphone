# Copy to .env.local (never commit). Variables prefixed NEXT_PUBLIC_ are visible in the browser: public values only.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# SERVER ONLY. Used exclusively by server actions that must create auth users (staff invitations).
# Never expose this to the browser and never commit it. Leave unset to disable staff invitations.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this dashboard (used for invitation links and the payment return page).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Deep-link scheme of the mobile app, used by /pay/return to hand the customer back to the app.
MOBILE_APP_SCHEME=infinityspa
