# Copy to .env (never commit). EXPO_PUBLIC_* values are embedded in the app bundle: public values ONLY.
# Never put a service-role key, payment secret key, webhook secret or SMTP credential here.

# Supabase project URL and publishable (anon) key — Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Google sign-in (OAuth client IDs are public identifiers)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Optional crash reporting (DSN is a public identifier)
EXPO_PUBLIC_SENTRY_DSN=

# Public admin/site URL, used for the payment return page and policy links
EXPO_PUBLIC_SITE_URL=https://admin.example.com

# Build-time only (EAS Secrets), required for Sentry source maps
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
